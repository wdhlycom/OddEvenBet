---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PlatformCard from '@/components/PlatformCard.astro'
import { bySlug } from '@/data/platforms'

// 分工：运动入门指南留在这里；评测与对比收在平台库（/zh/reviews）。
// 小众运动的盘口主要在加密平台，所以简介卡放加密平台。
const entries = (await getCollection('niche-sports', ({ data }) => !data.draft && data.lang === 'zh'))
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))

const guides = entries.filter((e) => e.data.kind === 'guide')

// 小众运动盘口集中的加密平台。slug 与 platforms.ts 一致；持牌法币平台放在主流体育板块。
// 每张卡深链到平台库里该平台的分组。
const platformSlugs = ['stake', 'bcgame']
const sectionPlatforms = platformSlugs.map(bySlug).filter(Boolean)
---

<BaseLayout
  title="小众体育博彩：电竞、飞镖、斯诺克、网球（中文）"
  description="小众体育博彩的中文指南——电竞、飞镖、斯诺克、网球等大站不做的市场。平台简介在这里，完整评测在平台库。"
  path="/zh/niche-sports"
  lang="zh"
>
  <section class="page-masthead">
    <div class="wrap">
      <span class="eyebrow">小众体育</span>
      <h1>大站不做的市场</h1>
      <p class="lede">
        电竞、飞镖、斯诺克、网球这些较小众的项目，反而是普通玩家能靠研究赚钱的地方。先看懂运动和盘口，再选平台。
      </p>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:64px;">
    {guides.length > 0 && (
      <div style="margin-top:32px;">
        <h2>先看懂运动</h2>
        <div class="grid">
          {guides.map((e) => (
            <article class="card card-link">
              <span class="meta">指南 · {e.data.updated.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long' })}</span>
              <h3><a href={`/zh/niche-sports/${e.id.replace(/^zh\//, '')}`}>{e.data.title}</a></h3>
              <p>{e.data.summary}</p>
            </article>
          ))}
        </div>
      </div>
    )}

    {sectionPlatforms.length > 0 && (
      <div style="margin-top:48px;">
        <h2>这些盘口在哪，一眼看懂</h2>
        <p class="muted" style="max-width:52ch;">
          这里只有一句话简介。详细的评测和对比都在<a href="/zh/reviews">平台库</a>。
        </p>
        <div class="grid">
          {sectionPlatforms.map((p) => p && <PlatformCard platform={p} href={`/zh/reviews#platform-${p.slug}`} lang="zh" />)}
        </div>
      </div>
    )}
  </section>
</BaseLayout>
