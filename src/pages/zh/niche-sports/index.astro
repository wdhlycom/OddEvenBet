---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'

const entries = (await getCollection('niche-sports', ({ data }) => !data.draft && data.lang === 'zh'))
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
---

<BaseLayout
  title="小众体育博彩：电竞、飞镖、斯诺克、网球（中文）"
  description="小众体育博彩的中文指南——电竞、飞镖、斯诺克、网球等大站不做的市场，中文原创内容。"
  path="/zh/niche-sports"
  lang="zh"
>
  <section class="page-masthead">
    <div class="wrap">
      <span class="eyebrow">小众体育</span>
      <h1>大站不做的市场</h1>
      <p class="lede">
        电竞、飞镖、斯诺克、网球这些较小众的项目，反而是普通玩家能靠研究赚钱的地方。这里按中文读者的习惯原创撰写。
      </p>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:64px;">
    {entries.length > 0 ? (
      <div class="grid">
        {entries.map((e) => (
          <article class="card card-link">
            <span class="meta">{e.data.updated.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long' })}</span>
            <h3><a href={`/zh/niche-sports/${e.id}`}>{e.data.title}</a></h3>
            <p>{e.data.summary}</p>
          </article>
        ))}
      </div>
    ) : (
      <p class="muted">中文内容正在逐步撰写中，敬请期待。</p>
    )}
  </section>
</BaseLayout>
