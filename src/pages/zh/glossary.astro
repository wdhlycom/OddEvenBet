---
import BaseLayout from '@/layouts/BaseLayout.astro'

// 术语按运动分组。每个词条：term=词名, en=英文/别名, def=2-3句详解, bet=对下注意味着什么。
// 词条末尾的 to 是可选的站内运动页链接。

interface Term {
  term: string
  en?: string
  def: string
  bet: string
  to?: string
}

interface Group {
  sport: string
  href?: string
  intro: string
  terms: Term[]
}

// 词条首字 → 拼音首字母（用于顶部字母索引）。只覆盖本页出现的词，避免引入完整拼音库。
const pinyinInitial: Record<string, string> = {
  独: 'D', 让: 'R', 总: 'Z', 滚: 'G', 亚: 'Y', 背: 'B', 轮: 'L', 七: 'Q',
  点: 'D', 守: 'S', 空: 'K', 先: 'X', 回: 'H', 获: 'H', 缠: 'C', 减: 'J',
  地: 'D', 场: 'C', 最: 'Z', 单: 'D',
}

// 取词条的索引键：中文取拼音首字母，英文/数字取首字符。
function termKey(t: Term): string {
  const head = t.term.trim()[0]
  if (!head) return '#'
  if (/[a-zA-Z]/.test(head)) return head.toUpperCase()
  if (/[0-9]/.test(head)) return '#'
  return pinyinInitial[head] ?? head
}

const groups: Group[] = [
  {
    sport: '通用盘口',
    intro: '不分运动、任何下注都可能碰到的词。先把这层看懂，再看各运动的专属词。',
    terms: [
      {
        term: '独赢 / moneyline',
        en: 'moneyline',
        def: '最基础的一种下注：只押谁赢，不看赢多少。弱队赢球的赔率会很高，因为难。',
        bet: '对新手来说这是最好上手的盘，先从这里练判断，再碰让分和大小分。',
        to: '/zh/learn/zh-san-da-pankou',
      },
      {
        term: '让分 / 点差',
        en: 'point spread',
        def: '给强队减分、弱队加分后再比谁赢，把强弱悬殊的比赛拉成五五开。比如「主队 -7.5」表示主队要净胜 8 分才算赢。',
        bet: '让分盘的陷阱在于：你押的不是「谁赢」，是「赢多少」。强队常胜但不常「赢够分」。',
        to: '/zh/learn/zh-san-da-pankou',
      },
      {
        term: '总分 / 大小分',
        en: 'over/under',
        def: '押两队总得分比一个设定数字大还是小，不押谁赢，只押「一共进多少」。',
        bet: '大小分适合你不确定谁赢、但能判断比赛节奏快慢的时候。',
        to: '/zh/learn/zh-san-da-pankou',
      },
      {
        term: '滚球 / 实时盘',
        en: 'live betting',
        def: '比赛开打后仍可下注，盘口跟着比分实时变动。',
        bet: '实时盘波动快，最容易让新手被情绪带着追单。先练熟赛前盘再碰它。',
        to: '/zh/learn/zh-gunqiu-shishenme',
      },
    ],
  },
  {
    sport: '足球',
    href: '/zh/major-sports/zh-zuqiu-xinshou-rumen',
    intro: '全球博彩体量最大的项目，术语也最多。',
    terms: [
      {
        term: '亚洲盘 / 让球',
        en: 'asian handicap',
        def: '给强队一个「负担」让比赛变五五开。整数盘（让 1 球）可能走水退款，带 0.5 的盘（让 0.5 球）不会走水，必分胜负。',
        bet: '带 0.5 的盘不会有「打平退钱」的情况，比整数盘更干脆，新手容易理解。',
      },
      {
        term: '1X2',
        def: '足球最基本的三种结果：1 = 主胜，X = 平局，2 = 客胜。',
        bet: '这是「三选一」，比让球盘的「二选一」难一点，但赔率结构更直白。',
      },
    ],
  },
  {
    sport: '篮球（NBA）',
    href: '/zh/major-sports/zh-nba-rumen',
    intro: '场次最密、变量最多的主流联赛，术语集中在盘口和赛程。',
    terms: [
      {
        term: '背靠背',
        en: 'back-to-back',
        def: '同一支球队连续两天各打一场比赛。第二场球员体力没恢复，状态明显下滑。',
        bet: '背靠背第二场的强队，冷门率比平时高，别把它当成和平时一样稳。',
      },
      {
        term: '轮休 / 负荷管理',
        en: 'load management',
        def: '球队故意让主力这一场不上场，省体力去打后面更重要的比赛。',
        bet: '下单前必查主力轮不轮休——一个主力缺阵就能改变整个盘口。',
      },
      {
        term: '七战四胜',
        en: 'best-of-seven',
        def: '季后赛系列赛的赛制，两支球队先赢 4 场者晋级。',
        bet: '系列赛场次多，冷门比单场定胜负少，强队更难被爆冷淘汰。',
      },
    ],
  },
  {
    sport: '美式足球（NFL）',
    href: '/zh/major-sports/zh-nfl-rumen',
    intro: '一周一场、节奏最慢的主流联赛，伤病和点差是核心。',
    terms: [
      {
        term: '点差',
        en: 'spread',
        def: '美式足球的让分盘，和篮球的让分同理，给强队减分后再比输赢。',
        bet: 'NFL 点差通常是 3 分左右，比赛分差小，胜负常在一球之间。',
      },
    ],
  },
  {
    sport: '冰球（NHL）',
    href: '/zh/major-sports/zh-bingqiu-nhl-rumen',
    intro: '进球少、节奏快，让分盘和守门员是关键。',
    terms: [
      {
        term: 'puck line',
        def: '冰球的让分盘，几乎固定让 1.5 球。因为冰球进球少，1.5 球已是很大的差距。',
        bet: 'puck line 固定 1.5，等于每次都在赌「赢球还得多进一球」，比独赢难。',
      },
      {
        term: '守门员',
        en: 'goalie',
