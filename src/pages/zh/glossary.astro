      {
        term: '空门进球',
        en: 'empty net goal',
        def: '落后方最后撤下守门员多上一名进攻球员，此时对手打进空门。',
        bet: '空门进球常发生在最后两分钟，1 分领先瞬间变 2 分，影响大小分盘的结算。',
      },
    ],
  },
  {
    sport: '棒球（MLB）',
    href: '/zh/major-sports/zh-mlb-rumen',
    intro: '赛程最长的联赛，先发投手决定大半场比赛。',
    terms: [
      {
        term: '先发投手',
        en: 'starting pitcher',
        def: '一场比赛开场的投手，要投大半场，他的状态直接决定比赛走向。',
        bet: 'MLB 下单前必看双方先发投手是谁——这比球队战绩更能预测结果。',
      },
      {
        term: 'run line',
        def: '棒球的让分盘，通常让 1.5 分。因为棒球比分普遍低，1.5 分已是不小差距。',
        bet: 'run line 固定 1.5，等于赌「赢球且分差够大」，比独赢赔率高但更难。',
      },
    ],
  },
  {
    sport: '格斗（UFC / MMA）',
    href: '/zh/niche-sports/zh-ufc-mma-rumen',
    intro: '信息量最大、最依赖选手风格的盘口。',
    terms: [
      {
        term: '回合盘',
        en: 'rounds / over-under rounds',
        def: '押比赛会不会打满某个回合，依赖选手「速战还是磨满全场」的风格。',
        bet: '回合盘的关键是判断两个选手的风格克制，而不是名气。',
      },
      {
        term: '获胜方式',
        en: 'method of victory',
        def: 'KO/TKO、降服、判定三选一，MMA 独有的、信息量最大的盘。',
        bet: '获胜方式盘回报最高，但要求你对双方技术特点有真判断，新手先看胜负盘。',
      },
      {
        term: '缠斗型 / 站立型',
        en: 'grappler / striker',
        def: 'MMA 最基础的风格判断：靠地面降服 vs 靠拳腿 KO。',
        bet: '风格克制比名气重要——一个缠斗高手遇到防摔强的站立选手，可能完全发挥不出来。',
      },
      {
        term: '减重 / 称重',
        en: 'weight cut / weigh-in',
        def: '赛前一天称重达标。减重失败会明显乏力，直接毁掉技术分析。',
        bet: '下单前查称重结果——减重异常的选手，状态往往崩得比技术差距更厉害。',
      },
    ],
  },
  {
    sport: '电竞',
    href: '/zh/niche-sports/zh-dianjing-xiashu-zhinan',
    intro: '年轻市场，术语集中在赛制和地图。',
    terms: [
      {
        term: '地图胜负',
        en: 'map winner',
        def: '押单张地图的胜负，变数比整场比赛大得多。',
        bet: '单张地图的冷门率远高于整场，新手从整场胜负盘入手更稳。',
      },
      {
        term: 'Major',
        def: 'CS2 的顶级官方赛事，反假赛机制成熟。',
        bet: 'Major 级别的赛事信息透明度高，比低级别赛事更适合新手下注。',
      },
    ],
  },
  {
    sport: '板球',
    href: '/zh/niche-sports/zh-banqiu-rumen',
    intro: '亚洲市场巨大，赛制和场地是关键变量。',
    terms: [
      {
        term: 'T20 / ODI / 测试赛',
        en: 'T20 / ODI / Test',
        def: '板球的三种赛制：T20 约 3 小时、ODI 约 8 小时、测试赛长达 5 天，节奏和冷门率完全不同。',
        bet: 'T20 节奏快、冷门多，测试赛节奏慢、强队更稳——先搞清你在看哪种赛制。',
      },
      {
        term: 'IPL',
        def: '印度超级联赛，全球最值钱的板球联赛，也是博彩最活跃的市场之一。',
        bet: 'IPL 赛季期间市场深度最好、盘口最多，是练手板球的好时机。',
      },
      {
        term: 'toss（掷硬币）',
        def: '赛前掷硬币决定谁先攻，某些场地先攻优势巨大。',
        bet: '掷硬币结果会立刻影响赔率，下单前先等 toss 结果出来。',
      },
      {
        term: 'pitch（场地）',
        def: '板球场的草皮，硬度湿度不同，决定是打手友好还是投手友好。',
        bet: '不同场地的 pitch 属性，直接影响大小分盘的走向，下注前要查。',
      },
    ],
  },
  {
    sport: '网球',
    href: '/zh/niche-sports/zh-wangqiu-rumen',
    intro: '场地类型决定一切。',
    terms: [
      {
        term: '让局 / 让盘',
        en: 'game/handicap',
        def: '强手让弱手几局或几盘，押能不能赢过这个让分。',
        bet: '让局盘的关键是判断强弱差距到底有多大，别只看排名。',
      },
      {
        term: '总局数',
        en: 'total games',
        def: '押整场总局数大于还是小于某个数。',
        bet: '总局数取决于场地——硬地回合多、草地回合少，同一个数在不同场地含义完全不同。',
      },
      {
        term: '场地类型',
        en: 'surface',
        def: '硬地、红土、草地球速和回合差异大，同一选手在不同场地表现天差地别。',
        bet: '下单前必看比赛在什么场地——红土高手到了草地可能被低排名选手爆冷。',
      },
    ],
  },
  {
    sport: '飞镖',
    href: '/zh/niche-sports/zh-feibiao-rumen',
    intro: '节奏快、冷门多的小众市场。',
    terms: [
      {
        term: '总 180',
        en: 'total 180s',
        def: '押全场打出几个「180 分」（单轮最高分）。',
        bet: '这类盘更接近彩蛋，趣味性强，别下重注。',
      },
      {
        term: '最高收尾',
        en: 'highest checkout',
        def: '押谁打出的收尾分最高。',
        bet: '好玩但随机性强，当作娱乐盘而非研究盘。',
      },
    ],
  },
  {
    sport: '斯诺克',
    href: '/zh/niche-sports/zh-sinuoke-rumen',
    intro: '适合做功课的人，变量集中在单杆数据。',
    terms: [
      {
        term: '单杆最高',
        en: 'highest break',
        def: '押全场谁打出单杆最高分。',
        bet: '这个盘依赖选手近期的单杆手感，做点功课就能找到价值。',
      },
      {
        term: '总破百',
        en: 'total centuries',
        def: '押全场打出几个「破百」（单杆 100 分以上）。',
        bet: '和单杆最高同理，适合研究型玩家，回报稳定但需要功课。',
      },
    ],
  },
]

// 术语结构化数据：把每个词条声明为 DefinedTerm，供搜索引擎理解本页是术语表。
const schema = groups.flatMap((g) =>
  g.terms.map((t) => ({
    '@type': 'DefinedTerm',
    name: t.term.split(' / ')[0],
    alternateName: t.en,
    description: `${t.def} ${t.bet}`,
    inDefinedTermSet: { '@type': 'DefinedTermSet', name: '体育博彩术语表' },
  })),
)

// 首字母索引：收集所有词条的 key，按字母排序，每个 key 对应第一个词条的锚点 id。
const allTerms = groups.flatMap((g) => g.terms.map((t) => ({ key: termKey(t), g, t })))
const indexMap = new Map<string, string>()
for (const { key, g, t } of allTerms) {
  if (!indexMap.has(key)) {
    const i = g.terms.indexOf(t)
    indexMap.set(key, `term-${key}-${i}`)
  }
}
const indexKeys = [...indexMap.keys()].sort((a, b) => {
  if (a === '#') return -1
  if (b === '#') return 1
  return a.localeCompare(b)
})
---

<BaseLayout
  title="体育博彩术语表（Glossary）"
  description="按运动分组的体育博彩术语详解：盘口、赛制、专有名词，每个词都讲清是什么、对下注意味着什么，新手查词一站解决。"
  path="/zh/glossary"
  lang="zh"
  schema={schema}
>
  <section class="page-masthead">
    <div class="wrap">
      <span class="eyebrow">Glossary</span>
      <h1>体育博彩术语表</h1>
      <p class="lede">
        按运动分组整理盘口、赛制、专有名词。每个词都讲清「是什么」和「对下注意味着什么」，
        新手看到不认识的词，来这一页查就行。最基础的盘口概念，先看<a href="/zh/learn/zh-san-da-pankou">三大基础盘口</a>。
      </p>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:64px;">
    <nav style="margin-bottom:32px;">
      <p class="muted small" style="margin:0 0 8px;">按首字母查词：</p>
      <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:20px;">
        {indexKeys.map((k) => (
          <a class="chip chip--idx" href={`#${indexMap.get(k)}`} style="text-decoration:none;">{k}</a>
        ))}
      </div>
      <p class="muted small" style="margin:0 0 8px;">按运动跳到：</p>
      <div style="display:flex;flex-wrap:wrap;gap:8px;">
        {groups.map((g) => (
          <a class="chip" href={`#${g.sport}`} style="text-decoration:none;">{g.sport}</a>
        ))}
      </div>
    </nav>

    {groups.map((g) => (
      <div id={g.sport} style="margin-top:40px;scroll-margin-top:80px;">
        <h2 style="text-transform:none;">
          {g.href ? <a href={g.href} style="text-decoration:none;color:inherit;">{g.sport}</a> : g.sport}
        </h2>
        <p class="muted">{g.intro}</p>
        <dl class="glossary">
          {g.terms.map((t, i) => (
            <div class="glossary-item" id={`term-${termKey(t)}-${i}`} style="scroll-margin-top:80px;">
              <dt>
                {t.term}
                {t.en && <span class="term-en">{t.en}</span>}
                {(t.to || g.href) && (
                  <a class="term-link" href={t.to ?? g.href}>
                    {t.to ? '详解 →' : `去 ${g.sport} 页 →`}
                  </a>
                )}
              </dt>
              <dd>
                <p>{t.def}</p>
                <p class="term-bet"><strong>对下注意味着什么：</strong>{t.bet}</p>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .glossary { margin: 0; }
  .glossary-item {
    padding: 16px 0;
    border-top: 1px solid var(--border, #333);
  }
  .glossary-item:last-child { border-bottom: 1px solid var(--border, #333); }
  .glossary-item dt {
    font-weight: 700;
    font-size: 1.05em;
  }
  .term-en {
    font-weight: 400;
    color: var(--muted, #888);
    margin-left: 8px;
    font-size: 0.9em;
  }
  .glossary-item dd { margin: 8px 0 0; }
  .glossary-item dd p { margin: 0 0 6px; }
  .term-bet { color: var(--muted, #999); font-size: 0.95em; }
  .term-link { font-weight: 400; font-size: 0.85em; margin-left: 8px; }
  .chip {
    display: inline-block;
    padding: 4px 12px;
    border: 1px solid var(--border, #333);
    border-radius: 999px;
    font-size: 0.9em;
  }
  .chip--idx {
    min-width: 32px;
    text-align: center;
    padding: 4px 8px;
    font-weight: 600;
  }
</style>
