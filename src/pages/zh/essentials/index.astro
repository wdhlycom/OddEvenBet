---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'

const entries = (await getCollection('essentials', ({ data }) => !data.draft && data.lang === 'zh'))
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))

// Chinese files live under essentials/zh/, so their id is "zh/<slug>".
// Strip the "zh/" prefix to get the clean URL slug.
const slugOf = (e: { id: string }) => e.id.replace(/^zh\//, '')

const topics = ['getting-started', 'betting-basics', 'betting-strategy', 'mindset'] as const
const topicLabels: Record<(typeof topics)[number], string> = {
  'getting-started': '从这里开始',
  'betting-basics': '基础知识 · 概念',
  'betting-strategy': '基础知识 · 策略',
  'mindset': '认知与心态',
}
const grouped = topics
  .map((t) => ({ topic: t, items: entries.filter((e) => e.data.topic === t) }))
  .filter((g) => g.items.length)
---

<BaseLayout
  title="必备：预测市场入门（中文）"
  description="用大白话讲清楚预测市场、事件合约、手续费、流动性和结算机制。中文原创内容，不是翻译。"
  path="/zh/essentials"
  lang="zh"
>
  <section class="page-masthead">
    <div class="wrap">
      <span class="eyebrow">必备</span>
      <h1>预测市场到底怎么运作</h1>
      <p class="lede">
        这些是定义性的文章，先于其他任何内容写好。中文版按中文读者的习惯单独撰写，不是英文的逐句翻译。
      </p>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:64px;">
    {grouped.map((g) => (
      <div style="margin-top:40px;">
        <h2 style="text-transform:none;">
          <a href={`/zh/essentials/topic/${g.topic}`} style="text-decoration:none;color:inherit;">{topicLabels[g.topic]}</a>
        </h2>
        <div class="grid">
          {g.items.map((e) => (
            <article class="card card-link">
              <h3><a href={`/zh/essentials/${slugOf(e)}`}>{e.data.question}</a></h3>
              <p>{e.data.answer}</p>
              <span class="meta">{e.data.updated.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            </article>
          ))}
        </div>
      </div>
    ))}
    {entries.length === 0 && (
      <p class="muted">中文内容正在逐步撰写中，敬请期待。</p>
    )}
  </section>
</BaseLayout>
