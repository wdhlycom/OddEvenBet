---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'

const entries = (await getCollection('niche-sports', ({ data }) => !data.draft && (data.lang ?? 'en') === 'en'))
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf())
---

<BaseLayout
  title="Niche sports betting: esports, darts, snooker and more"
  description="Guides and platform picks for niche sports betting — esports, darts, snooker, tennis and other markets the big comparison sites skip."
  path="/niche-sports"
>
  <section class="page-masthead">
    <div class="wrap">
      <span class="eyebrow">Niche Sports</span>
      <h1>The markets the big sites skip</h1>
      <p class="lede">
        Esports, darts, snooker and the smaller leagues are where a specialist can still
        out-rank the giants. We cover the betting markets and platforms here in depth.
      </p>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:64px;">
    {entries.length > 0 ? (
      <div class="grid">
        {entries.map((e) => (
          <article class="card card-link">
            <span class="meta">{e.data.kind} · {e.data.updated.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
            <h3><a href={`/niche-sports/${e.id}`}>{e.data.title}</a></h3>
            <p>{e.data.summary}</p>
          </article>
        ))}
      </div>
    ) : (
      <p class="muted">
        Content for this section is being written. We're starting with esports, darts and
        snooker guides — check back soon.
      </p>
    )}
  </section>
</BaseLayout>
