      },
    ],
  },
  {
    sport: 'Fútbol americano (NFL)',
    intro: 'Un partido por semana y un ritmo más lento; las lesiones y el hándicap son lo esencial.',
    terms: [
      {
        term: 'Spread',
        en: 'hándicap / point spread',
        def: 'El hándicap de la NFL, misma idea que en baloncesto: resta puntos al favorito y apuesta a cubrir.',
        bet: 'Los hándicaps de la NFL rondan los 3 puntos; los partidos se deciden por una sola anotación.',
      },
    ],
  },
  {
    sport: 'Hockey sobre hielo (NHL)',
    intro: 'Pocos goles y ritmo rápido; el portero y la puck line son clave.',
    terms: [
      {
        term: 'Puck line',
        en: 'línea de puck',
        def: 'El hándicap del hockey, casi siempre de 1,5 goles. Como se marcan pocos goles, 1,5 es un margen grande.',
        bet: 'Un 1,5 fijo significa que siempre necesitas ganar por dos, más difícil que el moneyline.',
