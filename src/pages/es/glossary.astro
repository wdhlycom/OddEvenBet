---
import BaseLayout from '@/layouts/BaseLayout.astro'

// Términos agrupados por deporte. Cada entrada: term=nombre, en=alias,
// def=explicación de 2-3 frases, bet=qué significa para tu apuesta. El campo
// opcional `to` enlaza al artículo en profundidad. A diferencia de la versión
// inglesa, los grupos deportivos no llevan `href` porque todavía no hay guías
// de deportes en español; enlazamos únicamente a artículos que existen.

interface Term {
  term: string
  en?: string
  def: string
  bet: string
  to?: string
}

interface Group {
  sport: string
  intro: string
  terms: Term[]
}

// Índice por la primera letra del término. Letras en mayúscula, dígitos como '#'.
function termKey(t: Term): string {
  const head = t.term.trim()[0]
  if (!head) return '#'
  if (/[a-zA-Z]/.test(head)) return head.toUpperCase()
  return '#'
}

const groups: Group[] = [
  {
    sport: 'Mercados generales',
    intro:
      'Mercados que puedes encontrar en cualquier deporte. Lee primero estos y luego los términos específicos de cada deporte.',
    terms: [
      {
        term: 'Moneyline',
        en: 'ganador directo',
        def: 'La apuesta más simple: elige quién gana, no por cuánto. Los no favoritos pagan más porque son más difíciles de acertar.',
        bet: 'El primer mercado para empezar. Practica aquí antes de tocar los hándicaps y los totales.',
        to: '/es/essentials/los-tres-mercados-basicos',
      },
      {
        term: 'Hándicap de puntos',
        en: 'point spread',
        def: 'Resta puntos al favorito o súmalos al no favorito, luego apuesta a quién cubre. «Local -7,5» significa que el local debe ganar por 8.',
        bet: 'La trampa es que no apuestas quién gana, sino por cuánto. Los favoritos suelen ganar sin cubrir el hándicap.',
        to: '/es/essentials/los-tres-mercados-basicos',
      },
      {
        term: 'Más/menos',
        en: 'totales / over-under',
        def: 'Apuesta si la suma de puntos de los dos equipos supera o no un número fijado, no quién gana.',
        bet: 'Útil cuando puedes leer el ritmo del partido pero no al ganador.',
        to: '/es/essentials/los-tres-mercados-basicos',
      },
      {
        term: 'Apuestas en vivo',
        en: 'live betting',
        def: 'Apostar después de empezar el partido; las cuotas se mueven con el marcador.',
        bet: 'Muy rápidas y fáciles de perseguir. Aprende primero los mercados previos al partido.',
      },
    ],
  },
  {
    sport: 'Fútbol',
    intro: 'El mayor mercado de apuestas del mundo, y el que tiene más términos.',
    terms: [
      {
        term: 'Hándicap asiático',
        en: 'asian handicap',
        def: 'Da un hándicap al favorito para igualar el partido. Las líneas enteras pueden anularse (reembolso); las líneas con ,5 siempre se liquidan.',
        bet: 'Las líneas con ,5 nunca se anulan y son más fáciles para principiantes.',
      },
      {
        term: '1X2',
        def: 'Los tres resultados básicos del fútbol: 1 = victoria local, X = empate, 2 = victoria visitante.',
        bet: 'Una apuesta a tres bandas con una estructura de cuotas más simple que un hándicap.',
      },
    ],
  },
  {
    sport: 'Baloncesto (NBA)',
    intro: 'El calendario más denso y con más variables; los términos giran en torno a las líneas y el descanso.',
    terms: [
      {
        term: 'Back-to-back',
        en: 'noches consecutivas',
        def: 'Un equipo que juega en noches consecutivas; el segundo partido se juega con piernas cansadas.',
        bet: 'Los favoritos en la segunda noche de un back-to-back se sorprenden más a menudo de lo normal.',
      },
      {
        term: 'Load management',
        en: 'gestión de carga',
        def: 'Los equipos descansan deliberadamente a los titulares en algunas noches para reservarlos para partidos más importantes.',
        bet: 'Revisa siempre quién descansa: una estrella ausente cambia toda la línea.',
      },
      {
        term: 'Best-of-seven',
        en: 'al mejor de siete',
        def: 'El formato de playoffs; gana el primero en llegar a cuatro victorias.',
