---
import { getCollection, render } from 'astro:content'
import ArticleLayout from '@/layouts/ArticleLayout.astro'
import ScoreCard from '@/components/ScoreCard.astro'
import AffiliateCTA from '@/components/AffiliateCTA.astro'
import PlatformCard from '@/components/PlatformCard.astro'
import CompareTable from '@/components/CompareTable.astro'
import { bySlug, ranked } from '@/data/platforms'

// Ruta de artículo para la colección de reseñas (centro de plataformas). Todas
// las reseñas, comparaciones y listas ordenadas se renderizan en /es/reviews/<slug>.
export async function getStaticPaths() {
  const entries = await getCollection('reviews', ({ data }) => !data.draft && data.lang === 'es')
  return entries.map((entry) => ({ params: { slug: entry.id.replace(/^es\//, '') }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const d = entry.data
const path = `/es/reviews/${entry.id.replace(/^es\//, '')}`
const section = 'Plataformas'
const sectionHref = '/es/reviews'

// ---- datos derivados según el kind ----
let schema: Record<string, unknown>[] = []
let reviewPlatform: ReturnType<typeof bySlug> = undefined
let list: ReturnType<typeof ranked> = []
let left: ReturnType<typeof bySlug> = undefined
let right: ReturnType<typeof bySlug> = undefined
let winner: 'left' | 'right' = 'left'

// Los enlaces relacionados pueden apuntar de vuelta a las secciones temáticas
// (guías/explicadores) además de otras páginas del centro, así que buscamos en
// todas las colecciones de artículos.
const articleCollections = ['reviews', 'prediction-markets', 'niche-sports', 'major-sports'] as const
const related = (await Promise.all(
  articleCollections.map((c) => getCollection(c, ({ data, id }) => d.related.includes(id) && !data.draft && data.lang === 'es')),
)).flat()
const relatedPath = (r: { collection: string; id: string }) => {
  const slug = r.id.replace(/^es\//, '')
  return r.collection === 'reviews' ? `/es/reviews/${slug}` : `/es/${r.collection}/${slug}`
}

if (d.kind === 'review') {
  reviewPlatform = bySlug(d.platformSlug)
  if (!reviewPlatform) {
    throw new Error(`La reseña "${entry.id}" referencia platformSlug "${d.platformSlug}" que no está en platforms.ts`)
  }
  schema = [{
    '@type': 'Review',
    name: d.title,
    description: d.description,
    dateModified: d.updated.toISOString(),
    author: { '@type': 'Person', name: d.author },
    reviewRating: {
      '@type': 'Rating',
      ratingValue: Object.values(reviewPlatform.scores).reduce((a, b) => a + b, 0) / 6,
      bestRating: 10,
      worstRating: 0,
    },
    itemReviewed: { '@type': 'Organization', name: reviewPlatform.name },
  }]
}

if (d.kind === 'compare') {
  left = bySlug(d.left)
  right = bySlug(d.right)
  if (!left || !right) throw new Error(`La comparación "${entry.id}" referencia un slug de plataforma desconocido`)
  winner = d.winner === d.left ? 'left' : 'right'
  schema = [{ '@type': 'Article', headline: d.title, description: d.description, dateModified: d.updated.toISOString(), author: { '@type': 'Person', name: d.author } }]
}

if (d.kind === 'best') {
  list = ranked(d.scope === 'all' ? undefined : d.scope)
  schema = [{
    '@type': 'ItemList',
    name: d.title,
    description: d.description,
    itemListElement: list.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.name })),
  }]
}
---

<ArticleLayout
  title={d.title}
  heading={d.title}
  description={d.description}
  path={path}
  section={section}
  sectionHref={sectionHref}
  updated={d.updated}
  author={d.author}
  schema={schema}
>
  {d.kind === 'review' && reviewPlatform && (
    <>
      <div class="callout">
        <strong>Veredicto</strong>
        {d.verdict}
      </div>

      <div style="margin:1.6em 0;">
        <AffiliateCTA
          url={d.affiliate ? reviewPlatform.affiliateUrl : null}
          platformName={reviewPlatform.name}
          label={`Abrir ${reviewPlatform.name}`}
        />
      </div>

      <h2>De un vistazo</h2>
      <div class="table-scroll">
        <table>
          <tbody>
            <tr><th scope="row">Comisiones</th><td>{reviewPlatform.fees}</td></tr>
            <tr><th scope="row">Depósito mínimo</th><td>{reviewPlatform.minDeposit}</td></tr>
            <tr><th scope="row">Métodos de pago</th><td>{reviewPlatform.payoutMethods}</td></tr>
            <tr><th scope="row">Velocidad de pago</th><td>{reviewPlatform.payoutSpeed}</td></tr>
            <tr><th scope="row">Licencia</th><td>{reviewPlatform.licence}</td></tr>
            <tr><th scope="row">Disponible en</th><td>{reviewPlatform.regions.join(', ')}</td></tr>
          </tbody>
        </table>
      </div>

      <ScoreCard scores={reviewPlatform.scores} lang="es" />

      <div class="pros-cons">
        <div>
          <h4>Lo que funciona</h4>
          <ul>{d.pros.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div>
          <h4>Lo que no funciona</h4>
          <ul>{d.cons.map((t) => <li>{t}</li>)}</ul>
        </div>
      </div>

      <div class="callout callout--warn">
        <strong>Quién debería evitarlo</strong>
        {d.notFor}
      </div>

      <Content />
    </>
  )}

  {d.kind === 'compare' && left && right && (
    <>
      <div class="callout">
        <strong>Ganador: {winner === 'left' ? left.name : right.name}</strong>
        {d.verdict}
      </div>

      <CompareTable leftName={left.name} rightName={right.name} rows={d.rows} winner={winner} lang="es" />

      <Content />

      <h2>Ambas plataformas, de un vistazo</h2>
      <div class="grid">
        <PlatformCard platform={left} lang="es" href={`/es/reviews#platform-${left.slug}`} />
        <PlatformCard platform={right} lang="es" href={`/es/reviews#platform-${right.slug}`} />
      </div>
    </>
  )}

  {d.kind === 'best' && (
    <>
      <p class="muted small">Para {d.audience}</p>

      <div class="callout">
        <strong>Cómo está ordenada esta lista</strong>
        {d.criteria}
      </div>

      <Content />

      <div class="grid" style="margin-top:2em;">
        {list.map((p, i) => (
          <PlatformCard platform={p} rank={i + 1} lang="es" href={`/es/reviews#platform-${p.slug}`} />
        ))}
      </div>
    </>
  )}

  {related.length > 0 && (
    <div style="margin-top:2.5em;">
      <h2>Sigue leyendo</h2>
      <ul>
        {related.map((r) => (
          <li><a href={relatedPath(r)}>{r.data.title}</a></li>
        ))}
      </ul>
    </div>
  )}
</ArticleLayout>
