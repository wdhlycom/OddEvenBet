---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'

const entries = (await getCollection('learn', ({ data }) => !data.draft && (data.lang ?? 'en') === 'en'))
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))

const topics = ['getting-started', 'betting-basics', 'betting-strategy', 'mindset'] as const
const topicLabels: Record<(typeof topics)[number], string> = {
  'getting-started': 'Getting started',
  'betting-basics': 'Betting 101 · Basics',
  'betting-strategy': 'Betting 101 · Strategy',
  'mindset': 'Risk & Mindset',
}
const grouped = topics.map((t) => ({ topic: t, items: entries.filter((e) => e.data.topic === t) }))
---

<BaseLayout
  title="Learn: prediction markets explained"
  description="Plain-English explainers on how prediction markets work, how they are priced, how fees are charged, and where they sit legally. No affiliate links in these pages."
  path="/learn"
>
  <section class="page-masthead">
    <div class="wrap">
      <span class="eyebrow">Learn</span>
      <h1>How this market actually works</h1>
      <p class="lede">
        Definitional pages, written before anything else on this site. They carry no affiliate
        links — if a page here convinces you to open an account, that happens on a review page, not here.
      </p>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:64px;">
    {grouped.map((g) => (
      <div style="margin-top:40px;">
        <h2 style="text-transform:none;">
          <a href={`/learn/topic/${g.topic}`} style="text-decoration:none;color:inherit;">{topicLabels[g.topic]}</a>
        </h2>
        <div class="grid">
          {g.items.length ? g.items.map((e) => (
            <article class="card card-link">
              <h3><a href={`/learn/${e.id}`}>{e.data.question}</a></h3>
              <p>{e.data.answer}</p>
              <span class="meta">{e.data.updated.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            </article>
          )) : (
            <p class="muted" style="margin:0;padding:16px 0;">More pages in this section are in progress.</p>
          )}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>
