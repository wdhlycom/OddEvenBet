---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const entries = await getCollection('learn', ({ data }) => !data.draft && (data.lang ?? 'en') === 'en')
  const topics = [...new Set(entries.map((e) => e.data.topic))]
  return topics.map((topic) => ({ params: { topic }, props: { topic } }))
}

const { topic } = Astro.props

const topics = ['getting-started', 'betting-basics', 'betting-strategy', 'mindset'] as const
const topicMeta: Record<string, { label: string; blurb: string }> = {
  'getting-started': { label: 'Getting started', blurb: 'What this site is and how to use it.' },
  'betting-basics': { label: 'Betting 101 · Basics', blurb: 'Odds, prices and contracts, in plain words.' },
  'betting-strategy': { label: 'Betting 101 · Strategy', blurb: 'Why most people lose, and how to avoid the traps.' },
  'mindset': { label: 'Risk & Mindset', blurb: 'How to think about risk and manage a bankroll.' },
}
const meta = topicMeta[topic] ?? { label: topic, blurb: '' }

const items = (await getCollection('learn', ({ data }) => !data.draft && (data.lang ?? 'en') === 'en' && data.topic === topic))
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
---

<BaseLayout
  title={`${meta.label} — Learn`}
  description={meta.blurb}
  path={`/learn/topic/${topic}`}
>
  <section class="page-masthead">
    <div class="wrap">
      <span class="eyebrow"><a href="/learn" style="text-decoration:none;color:inherit;">Learn</a></span>
      <h1>{meta.label}</h1>
      <p class="lede">{meta.blurb}</p>
    </div>
  </section>

  <section class="wrap" style="padding-block:40px 64px;">
    <div class="grid">
      {items.map((e) => (
        <article class="card card-link">
          <h3><a href={`/learn/${e.id}`}>{e.data.question}</a></h3>
          <p>{e.data.answer}</p>
          <span class="meta">{e.data.updated.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
