---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PlatformCard from '@/components/PlatformCard.astro'
import { site } from '@/data/site'
import { ranked } from '@/data/platforms'

// Reviews live in their own collection and render under /reviews/...
const reviews = (await getCollection('reviews', ({ data }) => !data.draft && data.kind === 'review' && (data.lang ?? 'en') === 'en'))
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf())
  .slice(0, 3)

const learn = (await getCollection('essentials', ({ data }) => !data.draft && (data.lang ?? 'en') === 'en'))
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf())
  .slice(0, 4)

const top = ranked().slice(0, 3)

const reviewPathFor = (e: { id: string }) => `/reviews/${e.id}`

const schema = [
  {
    '@type': 'CollectionPage',
    name: site.name,
    description: site.description,
    url: site.domain,
  },
]
---

<BaseLayout
  title={`${site.name} — ${site.tagline}`}
  description={site.description}
  path="/"
  schema={schema}
>
  <!-- ============ MASTHEAD — printed annual hero ============ -->
  <section class="masthead">
    <div class="masthead-main">
      <span class="kicker">Independent research · Vol. 1, 2026</span>
        <h1 class="display-title">Scored on evidence, not on who pays us.</h1>
        <!--
          Hero claims. Each sentence carries its own `claim--*` class plus a
          `data-evidence` pointer to the page that backs it, so the copy and the
          proof stay in sync. If an evidence page moves, update the pointer here.

          claim--rubric    → /methodology  (six weighted dimensions, published)
          claim--fees      → /reviews      (fee fields on every review)
          claim--checkable → /methodology  (data sources + corrections policy)
          claim--rankings  → /reviews      (each ranking card links to its review)
        -->
        <p class="standfirst">
          Prediction markets and sportsbooks, reviewed and ranked against a
          <a class="claim claim--rubric" href="/methodology" data-evidence="/methodology"><strong>published rubric</strong></a>.
          <span class="claim claim--fees" data-evidence="/reviews">Every fee is cited.</span>
          <span class="claim claim--checkable" data-evidence="/methodology">Every claim is checkable.</span>
          <span class="claim claim--rankings" data-evidence="/reviews">Every ranking links to the review behind it.</span>
        </p>
        <div style="display:flex; gap:14px; flex-wrap:wrap;">
          <a class="cta" href="/prediction-markets">See the reviews</a>
          <a class="cta cta--ghost" href="/essentials">Start with the basics</a>
        </div>
      </div>
  </section>

  <!-- ============ COLOUR FIELD — the three differences ============ -->
  <section class="colour-field colour-field--orange">
    <div class="wrap" style="padding-block:56px;">
      <span class="kicker" style="color:#141412;">What makes us different</span>
      <h2 style="margin-top:0; max-width:18ch;">Real events. Checkable results. No hidden strings.</h2>
      <div class="grid" style="margin-top:32px;">
        <article class="card">
          <span class="meta">01</span>
          <h3>A "verifiability" score no one else publishes</h3>
          <p>
            Every platform and market is rated on whether its result can be independently
            checked against an authoritative source — official stats, court records, a
            named regulator.
          </p>
        </article>
        <article class="card">
          <span class="meta">02</span>
          <h3>We teach you how to verify, not just where to click</h3>
          <p>
            Most sites tell you which platform is "best". We show you how to check for
            yourself whether a market is real and whether a licence is genuine.
          </p>
        </article>
        <article class="card">
          <span class="meta">03</span>
          <h3>Disclosure that actually discloses</h3>
          <p>
            Every page states whether it carries affiliate links. Rankings cannot be
            bought. We even list the partnerships we turned down.
            <a href="/disclosure" style="color:inherit; text-decoration:underline;">Read the full disclosure</a>.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ TOP RATED — on paper ============ -->
  <section class="wrap" style="padding-block:64px 24px;">
    <span class="eyebrow">Rankings · updated monthly</span>
    <h2 style="margin-top:0;">Top rated right now</h2>
    <p class="muted" style="max-width:44ch;">
      Ranked by the weighted score in our <a href="/methodology">methodology</a>.
      Fees and liquidity carry the most weight.
    </p>
    <div class="grid" style="margin-top:28px;">
      {top.map((p, i) => (
        <PlatformCard
          platform={p}
          rank={i + 1}
          href={`/reviews#platform-${p.slug}`}
        />
      ))}
    </div>
  </section>

  <!-- ============ COLOUR FIELD — latest reviews (sage) ============ -->
  <section class="colour-field colour-field--sage">
    <div class="wrap" style="padding-block:64px;">
      <span class="kicker" style="color:#141412;">Latest reviews</span>
      <h2 style="margin-top:0;">Fresh from the desk</h2>
      <div class="grid" style="margin-top:28px;">
        {reviews.map((r) => (
          <article class="card">
            <span class="meta">Review · {r.data.updated.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
            <h3><a href={reviewPathFor(r)}>{r.data.title}</a></h3>
            <p>{r.data.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ LEARN — on paper ============ -->
  <section class="wrap" style="padding-block:64px 24px;">
    <span class="eyebrow">Read before you deposit</span>
    <h2 style="margin-top:0;">Understand the mechanics first</h2>
    <p class="muted" style="max-width:44ch;">
      Most losses in this category come from not knowing how settlement, fees or
      liquidity work.
    </p>
    <div class="grid" style="margin-top:28px;">
      {learn.map((l) => (
        <article class="card">
          <span class="meta">{l.data.topic}</span>
          <h3><a href={`/essentials/${l.id}`}>{l.data.question}</a></h3>
          <p>{l.data.answer}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ============ COLOUR FIELD — manifesto (black) ============ -->
  <section class="colour-field colour-field--black">
    <div class="wrap" style="padding-block:64px;">
      <span class="kicker" style="color:var(--acid);">Our position</span>
      <h2 style="margin-top:0; max-width:20ch;">
        We are not a tipster. We are a check you can repeat.
      </h2>
      <p style="max-width:48ch; color:#b3aea4; font-size:1.05rem;">
        If a claim can't be verified, we say so — and we name what we could not
        confirm. That is the whole point of this publication.
      </p>
      <a class="cta" href="/methodology" style="background:var(--acid); color:#141412;">Read our methodology</a>
    </div>
  </section>
</BaseLayout>
