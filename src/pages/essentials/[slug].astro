---
import { getCollection, render } from 'astro:content'
import ArticleLayout from '@/layouts/ArticleLayout.astro'
import FAQ from '@/components/FAQ.astro'

export async function getStaticPaths() {
  const entries = await getCollection('essentials', ({ data }) => !data.draft && (data.lang ?? 'en') === 'en')
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const d = entry.data
const path = `/essentials/${entry.id}`

const related = (await getCollection('essentials', ({ data, id }) =>
  d.related.includes(id) && !data.draft && (data.lang ?? 'en') === 'en',
))

// Some essentials pages link to explainers that now live in a topic collection.
const topicRelated = (await Promise.all(
  (['prediction-markets', 'niche-sports', 'major-sports'] as const).map((c) =>
    getCollection(c, ({ data, id }) => d.related.includes(id) && !data.draft && (data.lang ?? 'en') === 'en'),
  ),
))
  .flat()
  .map((r) => ({
    href: `/${r.collection}/${r.id}`,
    title: r.data.title,
  }))

const essentialsRelated = related.map((r) => ({
  href: `/essentials/${r.id}`,
  title: r.data.question,
}))

const schema = [
  {
    '@type': 'Article',
    headline: d.question,
    description: d.description,
    dateModified: d.updated.toISOString(),
    author: { '@type': 'Person', name: d.author },
    publisher: { '@id': 'https://oddevenbet.com/#org' },
    mainEntityOfPage: `https://oddevenbet.com${path}`,
  },
]
---

<ArticleLayout
  title={d.title}
  heading={d.question}
  description={d.description}
  path={path}
  section="Essentials"
  sectionHref="/essentials"
  updated={d.updated}
  author={d.author}
  schema={schema}
>
  <div class="callout">
    <strong>Short answer</strong>
    {d.answer}
  </div>

  <Content />

  {(essentialsRelated.length > 0 || topicRelated.length > 0) && (
    <div style="margin-top:2.5em;">
      <h2>Keep reading</h2>
      <ul>
        {essentialsRelated.map((r) => (
          <li><a href={r.href}>{r.title}</a></li>
        ))}
        {topicRelated.map((r) => (
          <li><a href={r.href}>{r.title}</a></li>
        ))}
      </ul>
    </div>
  )}

  <FAQ items={[
    { q: d.question, a: d.answer },
  ]} />
</ArticleLayout>
