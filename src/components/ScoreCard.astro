---
/**
 * Per-dimension scorecard. Renders the exact rubric published on /methodology,
 * so a reader can verify a score instead of trusting a single number.
 */
import { scoreDimensions } from '@/data/site'
import type { ScoreKey } from '@/data/site'

interface Props {
  scores: Record<ScoreKey, number>
  /** Optional overall override; otherwise computed as the weighted average. */
  overall?: number
  /** Language for labels. Defaults to English; pass "zh" or "es". */
  lang?: 'en' | 'zh' | 'es'
}

const { scores, overall, lang = 'en' } = Astro.props

const weighted = scoreDimensions.reduce((sum, d) => sum + (scores[d.key] ?? 0) * d.weight, 0)
const final = overall ?? Math.round(weighted * 10) / 10

const labels = {
  en: {
    outOf: '/ 10 weighted score',
    follows: 'Scores follow our',
    rubric: 'published rubric',
    noPay: 'We do not accept payment for a rating.',
  },
  zh: {
    outOf: '/ 10 加权评分',
    follows: '评分依据我们',
    rubric: '公开的评分标准',
    noPay: '我们不为评分收受任何报酬。',
  },
  es: {
    outOf: '/ 10 puntuación ponderada',
    follows: 'Las puntuaciones siguen nuestra',
    rubric: 'rúbrica publicada',
    noPay: 'No aceptamos pagos por una puntuación.',
  },
}[lang]

const methodologyHref = lang === 'zh' ? '/zh/methodology' : lang === 'es' ? '/es/methodology' : '/methodology'

const dimLabels: Record<ScoreKey, string> = lang === 'zh'
  ? {
      fees: '手续费与出金结构',
      liquidity: '市场深度与流动性',
      usability: '易用性',
      trust: '牌照与资金安全',
      payout: '出金速度与方式',
      support: '客服与争议处理',
    }
  : lang === 'es'
    ? {
        fees: 'Comisiones y estructura de pago',
        liquidity: 'Profundidad y liquidez del mercado',
        usability: 'Usabilidad',
        trust: 'Licencia y seguridad de los fondos',
        payout: 'Velocidad y métodos de pago',
        support: 'Soporte y resolución de disputas',
      }
    : Object.fromEntries(scoreDimensions.map((d) => [d.key, d.label])) as Record<ScoreKey, string>
---

<div style="border:1px solid var(--rule); border-radius:var(--radius); padding:20px; margin:1.6em 0;">
  <div style="display:flex; align-items:baseline; gap:12px; margin-bottom:14px;">
    <strong style="font-size:2rem; letter-spacing:-.03em;">{final}</strong>
    <span class="muted small">{labels.outOf}</span>
  </div>

  <div style="display:grid; gap:9px;">
    {scoreDimensions.map((d) => (
      <div style="display:grid; grid-template-columns:1fr 90px 34px; gap:10px; align-items:center; font-size:.85rem;">
        <span>{dimLabels[d.key]}</span>
        <div style="height:6px; background:var(--rule); border-radius:999px; overflow:hidden;">
          <div style={`height:100%; width:${(scores[d.key] / 10) * 100}%; background:var(--accent);`} />
        </div>
        <span class="muted" style="text-align:right;">{scores[d.key]}</span>
      </div>
    ))}
  </div>

  <p class="small muted" style="margin:14px 0 0;">
    {labels.follows} <a href={methodologyHref}>{labels.rubric}</a>. {labels.noPay}
  </p>
</div>
