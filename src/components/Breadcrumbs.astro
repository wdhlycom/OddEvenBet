---
interface Crumb { label: string; href: string }
interface Props {
  items: Crumb[]
  /** Whether the last crumb is the current page (rendered as text, not a link). */
  current?: boolean
}
const { items, current = true } = Astro.props
---

<nav aria-label="Breadcrumb" class="crumbs-bar small muted">
  <ol style="list-style:none; display:flex; flex-wrap:wrap; gap:8px; padding:0; margin:0;">
    {items.map((item, i) => (
      <li style="display:flex; gap:8px; align-items:center;">
        {i > 0 && <span aria-hidden="true">/</span>}
        {current && i === items.length - 1
          ? <span aria-current="page">{item.label}</span>
          : <a href={item.href} style="color: var(--ink-soft);">{item.label}</a>}
      </li>
    ))}
  </ol>
</nav>
