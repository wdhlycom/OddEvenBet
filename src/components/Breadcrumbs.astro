---
interface Crumb { label: string; href: string }
interface Props { items: Crumb[] }
const { items } = Astro.props
---

<nav aria-label="Breadcrumb" class="crumbs-bar small muted">
  <ol style="list-style:none; display:flex; flex-wrap:wrap; gap:8px; padding:0; margin:0;">
    {items.map((item, i) => (
      <li style="display:flex; gap:8px; align-items:center;">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i === items.length - 1
          ? <span aria-current="page">{item.label}</span>
          : <a href={item.href} style="color: var(--ink-soft);">{item.label}</a>}
      </li>
    ))}
  </ol>
</nav>
