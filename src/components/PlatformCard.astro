---
import type { Platform } from '@/data/platforms'
import { localized } from '@/data/platforms'
import AffiliateCTA from './AffiliateCTA.astro'

interface Props {
  platform: Platform
  /** 1-based position, shown as a badge on ranking pages. */
  rank?: number
  /**
   * Where this card leads — usually the platform's own group on the Platforms
   * hub (`/reviews#platform-<slug>`), where every article about it is listed.
   * When set, the WHOLE card is clickable via a stretched link; the affiliate
   * CTA stays independently clickable above the overlay.
   */
  href?: string
  /** Language for labels. Defaults to English; pass "zh" or "es". */
  lang?: 'en' | 'zh' | 'es'
}

const { platform: p, rank, href, lang = 'en' } = Astro.props

// Scores are deliberately NOT shown here: the raw number without its rubric
// reads as arbitrary (and every honest score looks "low"). The six-dimension
// breakdown lives in each full review and on /methodology.
const t = lang === 'zh'
  ? { fees: '手续费', payout: '出金', licence: '牌照', open: '打开' }
  : lang === 'es'
    ? { fees: 'Comisiones', payout: 'Pago', licence: 'Licencia', open: 'Abrir' }
    : { fees: 'Fees', payout: 'Payout', licence: 'Licence', open: 'Open' }
---

<article class="card pcard">
  <h3>
    {rank && <span class="muted" style="margin-right:6px;">#{rank}</span>}
    {href ? <a class="pcard-link" href={href}>{p.name}</a> : p.name}
  </h3>

  <p>{localized(p, 'oneLiner', lang)}</p>

  <div class="small muted" style="display:grid; gap:4px; font-size:.82rem;">
    <div><strong>{t.fees}:</strong> {localized(p, 'fees', lang)}</div>
    <div><strong>{t.payout}:</strong> {localized(p, 'payoutSpeed', lang)}</div>
    <div><strong>{t.licence}:</strong> {localized(p, 'licence', lang)}</div>
  </div>

  <div style="margin-top:auto; padding-top:8px;">
    <AffiliateCTA url={p.affiliateUrl} platformName={p.name} label={`${t.open} ${p.name}`} />
  </div>
</article>
