---
import { site, nav, locales } from '@/data/site'
import { sibling, allRoutes } from '@/data/routes'
import Search from './Search.astro'

const path = Astro.url.pathname

// Detect the active language from the URL prefix, so the switcher can highlight
// the current locale and offer correct sibling links. Handles both "/zh" and "/zh/foo".
const activeLocale =
  locales.find((l) => l.prefix && (path === l.prefix || path.startsWith(l.prefix + '/'))) ??
  locales[0]

// Sibling links are resolved against the set of URLs this build actually emits,
// so a language switch can never land on a 404. Chinese articles for the topic
// collections use `zh-` slugs while English ones don't, which is why a plain
// prefix swap used to break; `sibling()` handles that and falls back to the
// section index rather than producing a dead link.
const options = await Promise.all(
  locales.map(async (l) => ({
    code: l.code,
    label: l.label,
    href: (await sibling(path, l.prefix)).href,
  })),
)

const homeHref = activeLocale.prefix || '/'

// Only render nav entries that exist in the active language. Spanish currently
// has no /es/prediction-markets or /es/glossary, and a nav link to a 404 is
// worse than a shorter menu.
const routes = await allRoutes()
const navItems = nav
  .map((item) => ({
    href: activeLocale.prefix + item.href,
    label: activeLocale.code === 'zh' ? item.labelZh : activeLocale.code === 'es' ? item.labelEs : item.label,
  }))
  .filter((item) => routes.has(item.href))
---

<header class="site-head">
  <div class="wrap head-inner">
    <a class="brand" href={homeHref}>{site.name}<span>.</span></a>

    <nav class="site-nav" aria-label="Primary">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={path.startsWith(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      </nav>

    <div class="head-controls">
      <Search lang={activeLocale.code} />

      <button
        class="theme-toggle"
        type="button"
        id="theme-toggle"
        aria-label="Toggle dark mode"
        title="Toggle dark mode"
      >
        <span class="theme-icon" data-theme-icon>◐</span>
      </button>

      <label class="lang-switch" aria-label="Language">
        <select id="lang-select">
          {options.map((l) => (
            <option value={l.href} selected={l.code === activeLocale.code}>
              {l.label}
            </option>
          ))}
        </select>
      </label>
    </div>
  </div>
</header>

<script>
  // ---- Theme toggle ----
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const current = document.documentElement.dataset.theme
    const next = current === 'dark' ? 'light' : 'dark'
    document.documentElement.dataset.theme = next
    localStorage.setItem('theme', next)
  })

  // ---- Language switch ----
  document.getElementById('lang-select')?.addEventListener('change', (e) => {
    const target = (e.target as HTMLSelectElement).value
    if (target && target !== window.location.pathname) {
      window.location.href = target
    }
  })
</script>
