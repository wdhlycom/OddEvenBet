---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import AuthorBox from '@/components/AuthorBox.astro'
import { site } from '@/data/site'

interface Crumb { label: string; href: string }

interface Props {
  title: string
  /** On-page H1. Often longer/more natural than the <title>. */
  heading: string
  description: string
  path: string
  section: string
  sectionHref: string
  updated: Date
  author: string
  /** Shows "By ... · Updated ..." line under the H1. */
  showByline?: boolean
  schema?: Record<string, unknown>[]
}

const {
  title, heading, description, path, section, sectionHref,
  updated, author, showByline = true, schema = [],
} = Astro.props

// Language is derived from the URL prefix (en has none). Article pages always
// carry the full path with their language prefix, so this is reliable and
// means the [slug].astro files don't each have to remember to pass `lang`.
const lang: 'en' | 'zh' | 'es' = path.startsWith('/es/') ? 'es' : path.startsWith('/zh/') ? 'zh' : 'en'

const ui = {
  en: { home: 'Home', by: 'By', updated: 'Updated', how: 'How we research this', methodology: '/methodology' },
  zh: { home: '首页', by: '作者', updated: '更新于', how: '我们的研究方法', methodology: '/zh/methodology' },
  es: { home: 'Inicio', by: 'Por', updated: 'Actualizado', how: 'Cómo investigamos esto', methodology: '/es/methodology' },
}[lang]

// Breadcrumbs stop at the section, not the article. Repeating a long headline
// in the trail wrapped onto three lines on phones and added nothing — the H1
// directly below already names the page.
const crumbs: Crumb[] = [
  { label: ui.home, href: '/' },
  { label: section, href: sectionHref },
]

const dateLabel = updated.toLocaleDateString(
  lang === 'zh' ? 'zh-CN' : lang === 'es' ? 'es-ES' : 'en-US',
  { year: 'numeric', month: 'long', day: 'numeric' },
)
---

<BaseLayout title={title} description={description} path={path} lang={lang} schema={schema}>
  <header class="page-masthead">
    <div class="wrap">
      <span class="eyebrow">{section}</span>
      <h1>{heading}</h1>
      {showByline && (
        <p class="muted small" style="margin: 14px 0 0;">
          {ui.by} {author} · {ui.updated} {dateLabel}
          {' · '}
          <a href={ui.methodology}>{ui.how}</a>
        </p>
      )}
    </div>
  </header>

  <article class="wrap" style="padding-block: 32px 20px;">
    <Breadcrumbs items={crumbs} current={false} />

    <div class="prose measure">
      <slot />
    </div>

    <div class="measure">
      <AuthorBox name={author} />
    </div>
  </article>
</BaseLayout>
